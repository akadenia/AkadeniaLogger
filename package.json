{
  "name": "@akadenia/logger",
  "version": "3.2.3",
  "description": "Akadenia library: Logger",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "logger",
    "akadenia",
    "sentry",
    "firebase",
    "signoz"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "jest",
    "format": "oxfmt",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "prepare": "pnpm build",
    "version": "git add -A src",
    "updateLink": "pnpm build && pnpm rm -g @akadenia/logger && pnpm add -g ."
  },
  "packageManager": "pnpm@11.9.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akadenia/AkadeniaLogger.git"
  },
  "author": "Akadenia",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/akadenia/AkadeniaLogger/issues"
  },
  "homepage": "https://akadenia.com/packages/akadenia-logger",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@jest/globals": "^30.5.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "semantic-release": "25.0.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@sentry/types": "^10.75.2"
  },
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=11.x"
  }
}
